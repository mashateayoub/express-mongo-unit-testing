{
  "name": "express-mongo-unit-testing",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node --env-file=.env src/main.js",
    "dev": "node --watch --env-file=.env src/main.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watchAll --runInBand",
    "test:coverage": "jest --coverage --runInBand"
  },
  "dependencies": {
    "express": "^5.0.0",
    "mongoose": "^9.0.0"
  },
  "devDependencies": {
    "jest": "^30.0.0"
  }
}
